# Copie para .env e troque os valores. O .env não vai para o git.
SECRET_KEY=troque-por-uma-chave-aleatoria

# Banco MySQL do docker-compose.yml
MYSQL_USER=admin
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=flask-crud

# Conexão da API (mesmo usuário e senha de cima)
DATABASE_URL=mysql+pymysql://admin:troque-esta-senha@127.0.0.1:3306/flask-crud
